<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Base theme is intentionally minimal. The Compose layer applies the full
      Material3 colour scheme; we only need the system bars to start with the
      brand background colour to avoid any flash on cold start.
    -->
    <style name="Theme.WoodworkingCalculatorPro" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/brand_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
