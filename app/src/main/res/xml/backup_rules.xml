<?xml version="1.0" encoding="utf-8"?>
<!--
  Backups are disabled at the manifest level (android:allowBackup="false")
  to keep the local Room database strictly on-device.
-->
<full-backup-content>
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="file" />
</full-backup-content>
